; Lit fruit: per-vertex colour with a soft directional light and a small highlight.
.fvec projection[4], modelView[4]
.fvec light, halfVec, shade   ; shade.x = ambient, shade.y = diffuse, shade.z = highlight, shade.w = opacity
.fvec skin                    ; skin.rgb = colour the fruit's brightness turns into, skin.w = how far

.constf numbers(0.0, 1.0, 0.00787401, 0.00392157)  ; 0, 1, 1/127, 1/255
.constf luma(0.3, 0.59, 0.11, 0.0)
.alias  zeros numbers.xxxx
.alias  ones  numbers.yyyy

.out outpos position
.out outclr color

.alias inpos v0
.alias innrm v1
.alias inclr v2

.proc main
	; Position: model -> view -> clip.
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; Normal, rotated with the model. Scale is cancelled through the light's length.
	mul r2.xyz, numbers.zzz, innrm.xyz
	dp3 r3.x, modelView[0], r2
	dp3 r3.y, modelView[1], r2
	dp3 r3.z, modelView[2], r2

	; Diffuse.
	dp3 r4.x, light, r3
	max r4.x, zeros, r4.x
	mul r4.x, shade.yyyy, r4.xxxx
	add r4.x, shade.xxxx, r4.xxxx

	; Highlight, a cheap power of 8.
	dp3 r5.x, halfVec, r3
	max r5.x, zeros, r5.x
	mul r5.x, r5.xxxx, r5.xxxx
	mul r5.x, r5.xxxx, r5.xxxx
	mul r5.x, r5.xxxx, r5.xxxx
	mul r5.x, shade.zzzz, r5.xxxx

	; Colour.
	mul r6, numbers.wwww, inclr
	; A Shop skin fades the fruit's own colours into its brightness times the skin's colour.
	dp3 r7.x, luma, r6
	mul r7.xyz, skin.xyz, r7.xxx
	mul r7.xyz, skin.www, r7.xyz
	mov r8.x, -skin.wwww
	add r8.x, ones, r8.xxxx
	mul r6.xyz, r8.xxx, r6.xyz
	add r6.xyz, r6.xyz, r7.xyz
	mul r6.xyz, r4.xxx, r6.xyz
	add r6.xyz, r5.xxx, r6.xyz
	mov r6.w, shade.wwww
	min r6, ones, r6
	mov outclr, r6
	end
.end
